# Copy to .env (never commit .env). Key NAMES only here.

# --- LLM for claim extraction: Claude OR ChatGPT, picked automatically (LLM_PROVIDER=auto) -------------
ANTHROPIC_API_KEY=                 
OPENAI_API_KEY=                    # ChatGPT/OpenAI: used if no Anthropic key (or force LLM_PROVIDER=openai)
# LLM_PROVIDER=auto                # auto | claude | chatgpt | heuristic (no LLM at all)
# LLM_MODEL=claude-haiku-5-5       # Claude model (ANTHROPIC_MODEL is ignored: it is Claude Code's own setting)
# OPENAI_MODEL=gpt-6-luna          # OpenAI model (e.g. gpt-5.6-luna, gpt-5.4-mini)
# LLM_BASE_URL=                    # any OpenAI-compatible server: OpenRouter, Groq, vLLM, Ollama (http://localhost:11434/v1)
# LLM_API_KEY=                     # key for that server if not OPENAI_API_KEY
# LLM_REASONING_EFFORT=            # OpenAI reasoning models: none (default) | low | ... | omit
# LLM_MAX_TOKENS_FIELD=            # max_completion_tokens (OpenAI default) | max_tokens (most compatible servers)
# LLM_THINKING=                    # Claude: disabled | adaptive | between_tools | omit
# CLAIM_TIMEOUT_S=2.5              # then heuristic fallback (default, see app/config.py)

# --- teammates ---------------------------------------------------------------------------------------
# A (ears):     DEEPGRAM_API_KEY= / ASSEMBLYAI_API_KEY=
# C (evidence): TAVILY_API_KEY= / EXA_API_KEY= / BRAVE_API_KEY= / GOOGLE_FACTCHECK_API_KEY=
# D (face):     CARTESIA_API_KEY=

# --- D: the referee's voice (app/face/tts.py; app/face/README.md "Voice") -----------------------------
ELEVENLABS_API_KEY=                # unset: espeak-ng if installed, else the browser's own speech
# ELEVENLABS_VOICE_ID=             # default JBFqnCBsd6RMkjVDRZzb (premade "George", British)
# ELEVENLABS_MODEL=eleven_v4_turbo           # Text to Dialogue WebSocket (primary)
# ELEVENLABS_HTTP_MODEL=eleven_multilingual_v2   # HTTP fallback (normalises numbers; Flash doesn't)
# ELEVENLABS_STABILITY=0.6
# TTS_PROVIDER=auto                # auto | eleven | eleven_http | espeak | none
# TTS_MISS_WAIT_S=2.5              # /face/tts gives up (504) after this; the late result is still cached
# TTS_PRESYNTH=lines               # lines | candidates (~10x the characters) | off. Free plan: 10,000 characters/month

# --- B: side bots (app/bots, run with BOTS=real; same Anthropic key as the brain) ------------------------
# BOTS_MIN_GAP_S=10                # per bot: at most one bubble this often
# BOTS_LINE_TTL_S=30               # a queued line older than this is dropped
# BOTS_VERDICT_WAIT_S=10           # wait this long for a sourced Verdict before the unsourced check
# BOTS_CHECK_MIN_CONF=0.80         # a "Last I checked" challenge or a concede only fires at or above this
# BOTS_MISLEADING_MIN_CONF=0.60    # a "True, but ..." challenge (true figure, misrepresented): its own bar
# BOTS_BANTER=1                    # bot-to-bot banter (0 = off)
# BOTS_BANTER_GAP_S=20             # at most one banter line this often, across both bots
# BOTS_MODEL=claude-haiku-5-5      # follow-ups and banter
# BOTS_CHECK_MODEL=claude-opus-5-5 # the unsourced knowledge check

# --- B: judge (app/judge, run with JUDGE=real; same Anthropic key): summary + verdict on the Final screen click ---
# JUDGE_MODEL=claude-opus-5-5      # weighs the scorecard + transcript, names the victor
# JUDGE_TIMEOUT_S=60               # then the scorecard formula decides
# JUDGE_SUMMARY_WAIT_S=15          # after the click, wait this long for the brain's debate summary, then judge without
# JUDGE_DIR=logs/summaries         # <run>-summary.md + .json
# JUDGE_DANCE_WIN=MMD-Conqueror    # the winner's bot (titles with spaces: keep the quotes)
# JUDGE_DANCE_LOSE="MMD-Lost One_s Weeping"
# JUDGE_DANCE_DRAW="MMD-皆大欢喜-卜逻desu"
# JUDGE_DANCE_S=30                 # the dances stop after this long (or at the next debate)
# JUDGE_MUSIC=winner               # winner (only the winner's dance has music) | none | both

# --- B: phone browser as a microphone, no app (app/face/phone_mic.py; docs/LIVE-MICS.md section 12) -------
# PHONE_MICS=A,B                   # null sinks whack_phone_A/_B (ears: MIC1=whack_phone_A.monitor); phones open /mic?ch=A
# MIC_TOKEN=                       # phones must add ?token=<this>; set it whenever HOST is not 127.0.0.1
# SSL_CERTFILE=cache/cert.pem      # both set = HTTPS (a phone on Wi-Fi needs it for its mic); a LAN bind (HOST=0.0.0.0)
# SSL_KEYFILE=cache/key.pem        #   also exposes /face/tts and /publish, so prefer USB + adb reverse

# --- tunables (see app/config.py) ----------------------------------------------------------------------
# DIRECTOR_AGGR=3 DIRECTOR_MIN_GAP_S=30 PAUSE_SYNTH=auto ARGMAP_K_TURNS=1
