@@ -0,0 +1,58 @@
+// Command-line and environment helpers shared by the referee runtime scripts (see README.md in this folder).
+using System;
+
+namespace MateReferee
+{
+    static class RefereeArgs
+    {
+        static string[] args;
+
+        static string[] Args
+        {
+            get
+            {
+                if (args != null) return args;
+                try { args = Environment.GetCommandLineArgs(); }
+                catch { args = Array.Empty<string>(); }
+                return args;
+            }
+        }
+
+        // Accepts both "-name" and "--name".
+        static bool IsFlag(string arg, string name) =>
+            arg.StartsWith("-", StringComparison.Ordinal) &&
+            string.Equals(arg.TrimStart('-'), name, StringComparison.OrdinalIgnoreCase);
+
+        public static bool Has(string name)
+        {
+            foreach (var a in Args)
+                if (IsFlag(a, name)) return true;
+            return false;
+        }
+
+        // The argument after the flag, or null when the flag is absent or is followed by another flag or nothing.
+        public static string Value(string name)
+        {
+            var a = Args;
+            for (int i = 0; i < a.Length; i++)
+            {
+                if (!IsFlag(a[i], name)) continue;
+                if (i + 1 >= a.Length || a[i + 1].StartsWith("-", StringComparison.Ordinal)) return null;
+                string v = a[i + 1].Trim().Trim('"');
+                return v.Length > 0 ? v : null;
+            }
+            return null;
+        }
+
+        // Trimmed value of an environment variable, or null when unset or blank.
+        public static string Env(string name)
+        {
+            try
+            {
+                string v = Environment.GetEnvironmentVariable(name);
+                return string.IsNullOrWhiteSpace(v) ? null : v.Trim();
+            }
+            catch { return null; }
+        }
+    }
+}
