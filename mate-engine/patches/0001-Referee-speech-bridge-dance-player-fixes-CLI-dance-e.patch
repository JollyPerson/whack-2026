diff --git a/Assets/MATE ENGINE - Referee/Runtime/SpeechBridgeConfig.cs b/Assets/MATE ENGINE - Referee/Runtime/SpeechBridgeConfig.cs
new file mode 100644
index 0000000..96784a5
--- /dev/null
+++ b/Assets/MATE ENGINE - Referee/Runtime/SpeechBridgeConfig.cs	
@@ -0,0 +1,87 @@
+// Settings for SpeechBridge. File: Application.persistentDataPath/speech_bridge.json
+// (Linux: ~/.config/unity3d/Shinymoon/MateEngineX/speech_bridge.json). Missing fields keep their defaults.
+// Precedence: "-speech-bridge [url]" on the command line > env MEX_SPEECH_BRIDGE=<url> > file > defaults.
+using System;
+using System.IO;
+using UnityEngine;
+
+namespace MateReferee
+{
+    [Serializable]
+    public sealed class SpeechBridgeConfig
+    {
+        public const string FileName = "speech_bridge.json";
+        public const string CliFlag = "speech-bridge";
+        public const string EnvVar = "MEX_SPEECH_BRIDGE";
+        const string DefaultServer = "http://127.0.0.1:8000";
+        const string DefaultPollPath = "/face/mate/next";
+
+        public bool enabled = false;
+        public string server = DefaultServer;
+        public string pollPath = DefaultPollPath;
+        public int fontSize = 40;
+        public int bubbleWidth = 720;
+        public float lingerSeconds = 3f;
+        public bool stopDanceOnSay = true;
+        public bool verbose = false;
+
+        [NonSerialized] public string source = "defaults";
+
+        public static SpeechBridgeConfig Load()
+        {
+            var cfg = new SpeechBridgeConfig();
+
+            string path = null;
+            try { path = Path.Combine(Application.persistentDataPath, FileName); } catch { }
+            if (path != null && File.Exists(path))
+            {
+                try { JsonUtility.FromJsonOverwrite(File.ReadAllText(path), cfg); cfg.source = path; }
+                catch (Exception e) { Debug.LogWarning("[SpeechBridge] ignoring unreadable " + path + ": " + e.Message); }
+            }
+
+            // MEX_SPEECH_BRIDGE=0|false|off|no turns it off even if the file enables it; 1|true|on|yes turns it on with
+            // the configured server; anything else is the server URL.
+            string env = RefereeArgs.Env(EnvVar);
+            if (env != null)
+            {
+                cfg.enabled = !IsOff(env);
+                if (cfg.enabled && !IsOn(env)) cfg.server = env;
+                cfg.source = "env " + EnvVar;
+            }
+
+            if (RefereeArgs.Has(CliFlag))
+            {
+                cfg.enabled = true;
+                string url = RefereeArgs.Value(CliFlag);
+                if (url != null) cfg.server = url;
+                cfg.source = "-" + CliFlag;
+            }
+
+            cfg.Sanitize();
+            return cfg;
+        }
+
+        static bool IsOff(string v) =>
+            v == "0" || v.Equals("false", StringComparison.OrdinalIgnoreCase) ||
+            v.Equals("off", StringComparison.OrdinalIgnoreCase) || v.Equals("no", StringComparison.OrdinalIgnoreCase);
+
+        static bool IsOn(string v) =>
+            v == "1" || v.Equals("true", StringComparison.OrdinalIgnoreCase) ||
+            v.Equals("on", StringComparison.OrdinalIgnoreCase) || v.Equals("yes", StringComparison.OrdinalIgnoreCase);
+
+        void Sanitize()
+        {
+            server = string.IsNullOrWhiteSpace(server) ? DefaultServer : server.Trim().TrimEnd('/');
+            if (server.IndexOf("://", StringComparison.Ordinal) < 0) server = "http://" + server; // "127.0.0.1:8000"
+            pollPath = string.IsNullOrWhiteSpace(pollPath) ? DefaultPollPath : pollPath.Trim();
+            if (!pollPath.StartsWith("/", StringComparison.Ordinal)) pollPath = "/" + pollPath;
+            fontSize = Mathf.Clamp(fontSize, 8, 200);
+            bubbleWidth = Mathf.Clamp(bubbleWidth, 120, 4000);
+            lingerSeconds = Mathf.Clamp(lingerSeconds, 0f, 60f);
+        }
+
+        public override string ToString() =>
+            server + pollPath + " fontSize=" + fontSize + " bubbleWidth=" + bubbleWidth + " lingerSeconds=" + lingerSeconds +
+            " stopDanceOnSay=" + stopDanceOnSay + " verbose=" + verbose + " (from " + source + ")";
+    }
+}
