@@ -0,0 +1,27 @@
+// Speech bridge wire protocol v1 (full text in README.md). JsonUtility cannot represent null or dictionaries,
+// so the server always sends every field; the defaults here only matter for a malformed response.
+using System;
+
+namespace MateReferee
+{
+    [Serializable]
+    public sealed class SpeechCmd
+    {
+        public string op = "";    // "say" | "talk" | "stop" | "dance" | "dance_stop"
+        public string id = "";    // say: Interjection.id; talk: TTSState.interjection_id or ""
+        public string text = "";  // say: exact bubble text
+        public string audio = ""; // say: relative WAV URL or "" (ME never plays audio; the browser tab does)
+        public string title = ""; // dance: title to play, "" = first available
+        public bool on;           // talk: TTSState.speaking
+        public bool clear;        // stop: also remove the bubble
+    }
+
+    [Serializable]
+    public sealed class SpeechBatch
+    {
+        public int v;
+        public string epoch = "";
+        public int cursor;
+        public SpeechCmd[] cmds = Array.Empty<SpeechCmd>();
+    }
+}
