index 0000000..7674b59
--- /dev/null
+++ b/Assets/MATE ENGINE - Referee/Runtime/SpeechBridge.cs	
@@ -0,0 +1,451 @@
+// Speech bridge: lets an external program make the avatar "say" a line (speech bubble + moving mouth) and dance,
+// over a small HTTP long-poll protocol (v1, full text in README.md). Off unless launched with
+// "-speech-bridge <url>", env MEX_SPEECH_BRIDGE=<url>, or {"enabled":true} in speech_bridge.json, so upstream
+// behaviour is unchanged by default. Pure consumer: it never sends anything to the server and never plays audio
+// (the server side owns the voice; "talk" only mirrors whether that voice is audible right now).
+using System;
+using System.Collections;
+using System.Collections.Generic;
+using CustomDancePlayer;
+using UnityEngine;
+using UnityEngine.Networking;
+
+namespace MateReferee
+{
+    public sealed class SpeechBridge : MonoBehaviour
+    {
+        const int PollWaitSeconds = 10;         // protocol default (server caps it at 25)
+        const int RequestTimeoutSeconds = 30;   // longer than the wait, so only a dead server times out
+        const float BackoffMin = 0.5f, BackoffMax = 5f;
+        const float MinEmptyPollSeconds = 0.5f; // pause after an empty answer that came back faster than this
+        const float NoTalkTimeout = 3f;         // show the whole line if no "talk on" arrives within this
+        const float RevealCharsPerSecond = 18f; // about speaking speed
+        const float MaxTalkSeconds = 12f;       // close the mouth if "talk off" never arrives
+        const int RememberIds = 50;             // "say" ids remembered for de-duplication
+        static readonly int IsTalkingHash = Animator.StringToHash("isTalking");
+
+        SpeechBridgeConfig cfg;
+
+        // Poll state.
+        int cursor = -1;
+        string epoch = "";
+        float backoff;
+        string linkState = "";
+
+        // Scene objects, re-resolved on every command because loading a VRM replaces the avatar.
+        Animator animator;
+        AvatarRandomMessages bubbleStyle;
+        AvatarDanceHandler dance;
+        Animator paramsCheckedOn;
+        RuntimeAnimatorController paramsCheckedController;
+        bool hasTalkParam;
+        float nextLazyResolve;
+
+        // Current line: pending (no bubble yet), revealing (bubble grows while talking) or shown.
+        string lineId = "", lineText = "";
+        float lineSaidAt;
+        SpeechBubble bubble;
+        bool revealing;
+        float revealProgress;
+        int revealedChars;
+        float removeAt = -1f;
+
+        // Mouth, mirroring TTSState.speaking.
+        bool talking;
+        string talkingId = "";
+        float talkOnAt;
+
+        readonly Queue<string> seenOrder = new Queue<string>();
+        readonly HashSet<string> seen = new HashSet<string>();
+        readonly HashSet<string> loggedOnce = new HashSet<string>();
+
+        static float Now => Time.unscaledTime;
+
+        [RuntimeInitializeOnLoadMethod(RuntimeInitializeLoadType.AfterSceneLoad)]
+        static void Boot()
+        {
+            try
+            {
+                var config = SpeechBridgeConfig.Load();
+                if (!config.enabled) return;
+                var go = new GameObject("SpeechBridge");
+                DontDestroyOnLoad(go);
+                go.AddComponent<SpeechBridge>().cfg = config;
+                Debug.Log("[SpeechBridge] enabled: " + config);
+            }
+            catch (Exception e) { Debug.LogWarning("[SpeechBridge] not started: " + e); }
+        }
+
+        void Start() => StartCoroutine(PollLoop());
+
+        void OnDestroy()
+        {
+            try { ClearLine(); CloseMouth(); }
+            catch (Exception e) { Debug.LogWarning("[SpeechBridge] cleanup failed: " + e.Message); }
+        }
+
+        // ---------------------------------------------------------------- polling
+
+        IEnumerator PollLoop()
+        {
+            while (true)
+            {
+                UnityWebRequest req = NewRequest();
+                UnityWebRequestAsyncOperation op = null;
+                if (req != null)
+                {
+                    // An exception here would end the coroutine, and with it the bridge, for the rest of the session.
+                    try { op = req.SendWebRequest(); }
+                    catch (Exception e) { req.Dispose(); SetLink("cannot poll: " + e.Message + " (retrying)", false); }
+                }
+                if (op == null) { yield return new WaitForSecondsRealtime(NextBackoff()); continue; }
+                float sentAt = Now;
+                yield return op;
+                int n = HandleResponse(req);
+                if (n < 0) yield return new WaitForSecondsRealtime(NextBackoff());
+                // A resync answers at once; a server that never waits would otherwise be polled every frame.
+                else if (n == 0 && Now - sentAt < MinEmptyPollSeconds) yield return new WaitForSecondsRealtime(MinEmptyPollSeconds);
+            }
+        }
+
+        UnityWebRequest NewRequest()
+        {
+            string url = cfg.server + cfg.pollPath + "?after=" + cursor + "&epoch=" + Uri.EscapeDataString(epoch) + "&wait=" + PollWaitSeconds;
+            try
+            {
+                var req = UnityWebRequest.Get(url);
+                req.timeout = RequestTimeoutSeconds;
+                if (cfg.verbose) Debug.Log("[SpeechBridge] GET " + url);
+                return req;
+            }
+            catch (Exception e)
+            {
+                SetLink("cannot poll '" + url + "': " + e.Message, false);
+                return null;
+            }
+        }
+
+        // Returns the number of commands, or -1 when the poll failed and the loop should back off.
+        int HandleResponse(UnityWebRequest req)
+        {
+            try
+            {
+                if (req.result != UnityWebRequest.Result.Success)
+                {
+                    SetLink("poll failed: " + (req.responseCode > 0 ? "HTTP " + req.responseCode : req.error) + " (retrying)", false);
+                    return -1;
+                }
+                var batch = JsonUtility.FromJson<SpeechBatch>(req.downloadHandler.text);
+                if (batch == null) throw new FormatException("empty body");
+                if (batch.v != 1) LogOnce("v" + batch.v, "[SpeechBridge] server sent protocol v" + batch.v + ", this build speaks v1");
+                string newEpoch = batch.epoch ?? "";
+                if (newEpoch != epoch && epoch.Length > 0) Debug.Log("[SpeechBridge] server epoch changed " + epoch + " -> " + newEpoch + "; resynced, nothing replayed");
+                epoch = newEpoch;
+                cursor = batch.cursor;
+                backoff = 0f;
+                SetLink("connected to " + cfg.server + " (epoch " + epoch + ")", true);
+                int n = batch.cmds != null ? batch.cmds.Length : 0;
+                if (cfg.verbose) Debug.Log("[SpeechBridge] cursor=" + cursor + " cmds=" + n);
+                for (int i = 0; i < n; i++)
+                    if (batch.cmds[i] != null) Execute(batch.cmds[i]);
+                return n;
+            }
+            catch (Exception e)
+            {
+                SetLink("bad response: " + e.Message + " (retrying)", false);
+                return -1;
+            }
+            finally { req.Dispose(); }
+        }
+
+        float NextBackoff()
+        {
+            backoff = backoff <= 0f ? BackoffMin : Mathf.Min(backoff * 2f, BackoffMax);
+            return backoff;
+        }
+
+        void SetLink(string state, bool ok)
+        {
+            if (state == linkState) return;
+            linkState = state;
+            if (ok) Debug.Log("[SpeechBridge] " + state);
+            else Debug.LogWarning("[SpeechBridge] " + state);
+        }
+
+        // ---------------------------------------------------------------- commands
+
+        void Execute(SpeechCmd c)
+        {
+            string op = c.op ?? "";
+            try
+            {
+                Resolve();
+                switch (op)
+                {
+                    case "say": Say(c.id ?? "", c.text ?? ""); break;
+                    case "talk": Talk(c.id ?? "", c.on); break;
+                    case "stop": Stop(c.clear); break;
+                    case "dance": Dance(c.title ?? ""); break;
+                    case "dance_stop": DanceStop(); break;
+                    default: LogOnce("op:" + op, "[SpeechBridge] ignoring unknown op '" + op + "'"); break;
+                }
+            }
+            catch (Exception e) { LogOnce("exec:" + op + ":" + e.GetType().Name, "[SpeechBridge] '" + op + "' failed: " + e); }
+        }
+
+        void Say(string id, string text)
+        {
+            if (id.Length > 0)
+            {
+                if (seen.Contains(id)) { if (cfg.verbose) Debug.Log("[SpeechBridge] say " + id + " already shown; ignored"); return; }
+                Remember(id);
+            }
+            if (cfg.stopDanceOnSay && dance != null && dance.IsPlaying)
+            {
+                dance.StopPlay();
+                Debug.Log("[SpeechBridge] stopped the dance to speak");
+            }
+            ClearLine(); // replaces the previous bubble; the mouth keeps following "talk"
+            if (text.Length == 0) return;
+            lineId = id;
+            lineText = text;
+            lineSaidAt = Now;
+            Debug.Log("[SpeechBridge] say " + (id.Length > 0 ? id : "(no id)") + " (" + text.Length + " chars)");
+        }
+
+        void Talk(string id, bool on)
+        {
+            if (on)
+            {
+                talking = true;
+                talkingId = id;
+                talkOnAt = Now;
+                SetMouth(true);
+                if (lineText.Length > 0 && IsCurrentLine(id))
+                {
+                    removeAt = -1f; // stays until "talk off" + linger
+                    if (bubble == null && ShowBubble())
+                    {
+                        revealing = true;
+                        revealProgress = 0f;
+                        revealedChars = 0;
+                    }
+                }
+            }
+            else
+            {
+                if (talking && id.Length > 0 && talkingId.Length > 0 && id != talkingId)
+                {
+                    if (cfg.verbose) Debug.Log("[SpeechBridge] talk off for " + id + " ignored (speaking " + talkingId + ")");
+                    return;
+                }
+                CloseMouth();
+                if (lineText.Length > 0 && IsCurrentLine(id)) FinishLine(cfg.lingerSeconds);
+            }
+            if (cfg.verbose) Debug.Log("[SpeechBridge] talk " + (on ? "on " : "off ") + id);
+        }
+
+        void Stop(bool clear)
+        {
+            CloseMouth();
+            if (clear) ClearLine();
+            else if (lineText.Length > 0) FinishLine(BubbleOnlySeconds(lineText));
+            Debug.Log("[SpeechBridge] stop" + (clear ? " (clear)" : ""));
+        }
+
+        void Dance(string title)
+        {
+            if (dance == null) { Debug.LogWarning("[SpeechBridge] dance: no AvatarDanceHandler in the scene"); return; }
+            if (dance.enableSync)
+            {
+                // The multi-instance sync starts menu plays and auto-next 1.5 s late; PlayIndex itself is not delayed.
+                dance.enableSync = false;
+                Debug.Log("[SpeechBridge] dance sync disabled for this session (no 1.5 s lead-in)");
+            }
+            int index = title.Length > 0 ? dance.FindIndexByTitle(title) : 0;
+            if (index < 0)
+            {
+                Debug.LogWarning("[SpeechBridge] dance '" + title + "' not found; playing the first dance instead");
+                index = 0;
+            }
+            bool ok = dance.PlayIndex(index);
+            Debug.Log("[SpeechBridge] dance '" + title + "' index " + index + " -> " +
+                      (ok ? "starting" : "not started (no dances installed, or the avatar has no animator)"));
+        }
+
+        void DanceStop()
+        {
+            if (dance == null) return;
+            dance.StopPlay();
+            Debug.Log("[SpeechBridge] dance stopped");
+        }
+
+        bool IsCurrentLine(string id) => id.Length == 0 || lineId.Length == 0 || id == lineId;
+
+        void Remember(string id)
+        {
+            seen.Add(id);
+            seenOrder.Enqueue(id);
+            while (seenOrder.Count > RememberIds) seen.Remove(seenOrder.Dequeue());
+        }
+
+        static float BubbleOnlySeconds(string text)
+        {
+            int words = text.Split((char[])null, StringSplitOptions.RemoveEmptyEntries).Length;
+            return Mathf.Max(4f, words / 2.5f + 3f);
+        }
+
+        // ---------------------------------------------------------------- bubble
+
+        bool ShowBubble()
+        {
+            if (bubbleStyle == null || bubbleStyle.chatContainer == null) Resolve();
+            if (bubbleStyle == null)
+            {
+                LogOnce("nostyle", "[SpeechBridge] cannot show a bubble: no AvatarRandomMessages with a chatContainer in the scene");
+                return false;
+            }
+            try { bubble = SpeechBubble.Create(bubbleStyle, cfg.fontSize, cfg.bubbleWidth); }
+            catch (Exception e)
+            {
+                LogOnce("create:" + e.GetType().Name, "[SpeechBridge] cannot create the bubble: " + e);
+                return false;
+            }
+            Debug.Log("[SpeechBridge] bubble shown on '" + bubbleStyle.chatContainer.name + "' (fontSize " + cfg.fontSize + ", width " + cfg.bubbleWidth + ")");
+            return true;
+        }
+
+        // Shows the whole line now and removes it after `seconds`.
+        void FinishLine(float seconds)
+        {
+            if (bubble == null && !ShowBubble()) { ClearLine(); return; }
+            bubble.SetText(lineText);
+            revealing = false;
+            removeAt = Now + seconds;
+        }
+
+        void ClearLine()
+        {
+            if (bubble != null) { bubble.Destroy(); bubble = null; }
+            lineId = "";
+            lineText = "";
+            revealing = false;
+            removeAt = -1f;
+        }
+
+        // ---------------------------------------------------------------- mouth
+
+        void CloseMouth()
+        {
+            if (!talking) return; // never touch isTalking unless we opened it
+            talking = false;
+            talkingId = "";
+            SetMouth(false);
+        }
+
+        void SetMouth(bool open)
+        {
+            var a = animator;
+            if (a == null || !a.isActiveAndEnabled || a.runtimeAnimatorController == null) return;
+            if (a != paramsCheckedOn || a.runtimeAnimatorController != paramsCheckedController)
+            {
+                var ps = a.parameters;
+                if (ps.Length == 0) return; // animator not initialised yet; check again next frame
+                paramsCheckedOn = a;
+                paramsCheckedController = a.runtimeAnimatorController;
+                hasTalkParam = false;
+                foreach (var p in ps)
+                    if (p.nameHash == IsTalkingHash && p.type == AnimatorControllerParameterType.Bool) { hasTalkParam = true; break; }
+                if (!hasTalkParam) LogOnce("noparam", "[SpeechBridge] the avatar's animator has no 'isTalking' bool; the mouth will not move");
+            }
+            if (hasTalkParam && a.GetBool(IsTalkingHash) != open) a.SetBool(IsTalkingHash, open);
+        }
+
+        // ---------------------------------------------------------------- scene lookup
+
+        void Resolve()
+        {
+            GameObject model = null, main = null;
+            var loader = FindFirstObjectByType<VRMLoader>();
+            if (loader != null)
+            {
+                main = loader.mainModel;
+                var current = loader.GetCurrentModel();
+                model = current != null && current.activeInHierarchy ? current : main;
+            }
+            animator = model != null ? model.GetComponentInChildren<Animator>() : null;
+
+            // The bubble style/container: the active avatar's AvatarRandomMessages, else the built-in avatar's
+            // (a custom VRM may get one without a chatContainer), else any in the scene.
+            bubbleStyle = StyleOn(model);
+            if (bubbleStyle == null) bubbleStyle = StyleOn(main);
+            if (bubbleStyle == null)
+                foreach (var a in FindObjectsByType<AvatarRandomMessages>(FindObjectsInactive.Include, FindObjectsSortMode.None))
+                    if (a != null && a.chatContainer != null) { bubbleStyle = a; break; }
+            if (animator == null && bubbleStyle != null) animator = bubbleStyle.GetComponent<Animator>();
+
+            dance = FindFirstObjectByType<AvatarDanceHandler>();
+        }
+
+        static AvatarRandomMessages StyleOn(GameObject go)
+        {
+            if (go == null) return null;
+            foreach (var a in go.GetComponentsInChildren<AvatarRandomMessages>(true))
+                if (a != null && a.chatContainer != null) return a;
+            return null;
+        }
+
+        // ---------------------------------------------------------------- per frame
+
+        void Update()
+        {
+            try
+            {
+                float now = Now;
+                if (bubble != null && !bubble.Alive)
+                {
+                    Debug.LogWarning("[SpeechBridge] the bubble was destroyed by something else; line dropped");
+                    ClearLine();
+                }
+                if (lineText.Length > 0 && bubble == null && now - lineSaidAt >= NoTalkTimeout)
+                    FinishLine(BubbleOnlySeconds(lineText)); // no voice: bubble only
+
+                if (revealing)
+                {
+                    revealProgress += RevealCharsPerSecond * Time.unscaledDeltaTime;
+                    int n = Mathf.Min(lineText.Length, Mathf.FloorToInt(revealProgress));
+                    if (n != revealedChars) { revealedChars = n; bubble.SetText(lineText.Substring(0, n)); }
+                    if (n >= lineText.Length) revealing = false;
+                }
+
+                if (talking && now - talkOnAt > MaxTalkSeconds)
+                {
+                    Debug.LogWarning("[SpeechBridge] no 'talk off' after " + MaxTalkSeconds + " s; closing the mouth");
+                    CloseMouth();
+                    if (lineText.Length > 0) FinishLine(cfg.lingerSeconds);
+                }
+
+                if (removeAt >= 0f && now >= removeAt) ClearLine();
+            }
+            catch (Exception e) { LogOnce("update:" + e.GetType().Name, "[SpeechBridge] Update failed: " + e); }
+        }
+
+        // ME's own scripts may reset isTalking (e.g. when a random-message bubble finishes), so re-apply it while talking.
+        void LateUpdate()
+        {
+            if (!talking) return;
+            try
+            {
+                // Also after an avatar swap mid-line: the old model is deactivated (built-in) or destroyed (custom VRM).
+                if ((animator == null || !animator.isActiveAndEnabled) && Now >= nextLazyResolve) { nextLazyResolve = Now + 1f; Resolve(); }
+                SetMouth(true);
+            }
+            catch (Exception e) { LogOnce("late:" + e.GetType().Name, "[SpeechBridge] LateUpdate failed: " + e); }
+        }
+
+        void LogOnce(string key, string message)
+        {
+            if (loggedOnce.Add(key)) Debug.LogWarning(message);
+        }
+    }
+}
