@@ -0,0 +1,76 @@
+// Test hook: "--dance-autoplay <title>" (or env MEX_DANCE_AUTOPLAY=<title>; "*" = the first dance) plays a dance
+// through ME's own CustomDancePlayer.AvatarDanceHandler shortly after startup, logs its state once a second for
+// about 8 s, then stops it, so a -batchmode run proves "load + play" from Player.log alone. Off by default.
+using System.Collections;
+using CustomDancePlayer;
+using UnityEngine;
+
+namespace MateReferee
+{
+    public sealed class DanceAutoplay : MonoBehaviour
+    {
+        const string CliFlag = "dance-autoplay";
+        const string EnvVar = "MEX_DANCE_AUTOPLAY";
+        const float FindTimeoutSeconds = 30f;
+        const int LogSeconds = 8;
+
+        string title;
+
+        [RuntimeInitializeOnLoadMethod(RuntimeInitializeLoadType.AfterSceneLoad)]
+        static void Boot()
+        {
+            string t = RefereeArgs.Value(CliFlag) ?? RefereeArgs.Env(EnvVar);
+            if (t == null) return;
+            var go = new GameObject("DanceAutoplay");
+            DontDestroyOnLoad(go);
+            go.AddComponent<DanceAutoplay>().title = t;
+        }
+
+        int IndexOf(AvatarDanceHandler h) => title == "*" ? 0 : h.FindIndexByTitle(title);
+
+        IEnumerator Start()
+        {
+            // AvatarDanceHandler.Start and MEModHandler's boot RescanMods() scan the dances in the first frames.
+            AvatarDanceHandler h = null;
+            int index = -1;
+            float t0 = Time.realtimeSinceStartup;
+            while (Time.realtimeSinceStartup - t0 < FindTimeoutSeconds)
+            {
+                yield return new WaitForSecondsRealtime(1f);
+                h = FindFirstObjectByType<AvatarDanceHandler>();
+                if (h != null && (index = IndexOf(h)) >= 0) break;
+            }
+            Debug.Log("[DanceAutoplay] title='" + title + "' handler=" + (h != null) + " index=" + index);
+            if (h == null || index < 0)
+            {
+                Debug.LogError("[DanceAutoplay] dance not found after " + FindTimeoutSeconds + " s (see the '[AvatarDanceHandler] Found' line)");
+                yield break;
+            }
+
+            yield return new WaitForSecondsRealtime(1f); // let a late rescan settle
+            index = IndexOf(h);
+            Debug.Log("[DanceAutoplay] PlayIndex -> " + h.PlayIndex(index));
+            for (int i = 0; i < LogSeconds; i++)
+            {
+                yield return new WaitForSecondsRealtime(1f);
+                Debug.Log(Describe(h));
+            }
+
+            h.StopPlay();
+            yield return new WaitForSecondsRealtime(2.5f);
+            Debug.Log("[DanceAutoplay] after StopPlay IsPlaying=" + h.IsPlaying);
+            Destroy(gameObject);
+        }
+
+        static string Describe(AvatarDanceHandler h)
+        {
+            var clip = h.GetCurrentClip();
+            var src = h.audioSource;
+            return "[DanceAutoplay] IsPlaying=" + h.IsPlaying +
+                   " clip=" + (clip != null ? clip.name + "/" + clip.length.ToString("0.00") + "s" : "none") +
+                   " audio=" + (src != null && src.clip != null ? src.clip.name : "none") +
+                   " playing=" + (src != null && src.isPlaying) +
+                   " t=" + h.GetPlaybackTime().ToString("0.00") + "/" + h.GetPlaybackLength().ToString("0.00");
+        }
+    }
+}
