diff --git a/Assets/MATE ENGINE - Referee/Runtime/SpeechBubble.cs b/Assets/MATE ENGINE - Referee/Runtime/SpeechBubble.cs
new file mode 100644
index 0000000..e6c2558
--- /dev/null
+++ b/Assets/MATE ENGINE - Referee/Runtime/SpeechBubble.cs	
@@ -0,0 +1,84 @@
+// A speech bubble built the way AvatarRandomMessages.ShowSpecificMessage builds ME's own (through LLMUnity's
+// LLMUnitySamples.Bubble, MIT licence): same container, sprite, font, colours, padding, spacing, sorting and
+// material, but sized for a projector, with no typing sound and with rich text off so the line is shown verbatim.
+// It creates the UI objects itself, mirroring Bubble's construction step for step, because Bubble is internal to
+// Assembly-CSharp: using only public types, this Runtime folder also compiles as a separate DLL against a released
+// build's Managed/Assembly-CSharp.dll (the no-rebuild fallback).
+using UnityEngine;
+using UnityEngine.UI;
+
+namespace MateReferee
+{
+    sealed class SpeechBubble
+    {
+        readonly GameObject root;
+        readonly Text label;
+
+        SpeechBubble(GameObject root, Text label)
+        {
+            this.root = root;
+            this.label = label;
+        }
+
+        // False once the bubble's GameObject is gone (removed by us, or destroyed by someone else).
+        public bool Alive => root != null;
+
+        public static SpeechBubble Create(AvatarRandomMessages style, int fontSize, int width)
+        {
+            float pad = style.textPadding, offset = style.bubbleSpacing;
+
+            // Bubble.CreateTextObject: fixed width (bubbleWidth != -1), height follows the text (bubbleHeight == -1).
+            var textGo = new GameObject("SpeechBridgeBubble", typeof(RectTransform), typeof(Text), typeof(Canvas));
+            textGo.transform.SetParent(style.chatContainer);
+            var text = textGo.GetComponent<Text>();
+            textGo.AddComponent<ContentSizeFitter>().verticalFit = ContentSizeFitter.FitMode.PreferredSize;
+            text.text = "";
+            if (style.font != null) text.font = style.font;
+            text.fontSize = fontSize;
+            text.color = style.fontColor;
+            text.supportRichText = false;
+
+            // Bubble.CreateImageObject, plus ShowSpecificMessage's material.
+            var imageGo = new GameObject("Image", typeof(RectTransform), typeof(Image), typeof(Canvas));
+            imageGo.transform.SetParent(textGo.transform);
+            var image = imageGo.GetComponent<Image>();
+            image.type = Image.Type.Sliced;
+            image.sprite = style.bubbleSprite;
+            image.color = style.bubbleColor;
+            if (style.bubbleMaterial != null) image.material = style.bubbleMaterial;
+
+            // Bubble.SetBubblePosition with leftPosition = 1, bottomPosition = 0: anchored bottom-right.
+            var rt = textGo.GetComponent<RectTransform>();
+            rt.pivot = rt.anchorMin = rt.anchorMax = new Vector2(1f, 0f);
+            rt.localScale = Vector3.one;
+            rt.anchoredPosition = new Vector2(-(offset + pad), offset + pad);
+            rt.sizeDelta = new Vector2(width - 2f * pad, rt.sizeDelta.y - 2f * pad);
+            var irt = imageGo.GetComponent<RectTransform>();
+            irt.anchorMin = Vector2.zero;
+            irt.anchorMax = Vector2.one;
+            irt.pivot = new Vector2(0.5f, 0.5f);
+            irt.offsetMin = new Vector2(-pad, -pad);
+            irt.offsetMax = new Vector2(pad, pad);
+
+            // Bubble.SetSortingOrder: text in front of its image.
+            var textCanvas = textGo.GetComponent<Canvas>();
+            textCanvas.overrideSorting = true;
+            textCanvas.sortingOrder = 2;
+            var imageCanvas = imageGo.GetComponent<Canvas>();
+            imageCanvas.overrideSorting = true;
+            imageCanvas.sortingOrder = 1;
+
+            return new SpeechBubble(textGo, text);
+        }
+
+        public void SetText(string text)
+        {
+            if (label != null) label.text = text;
+        }
+
+        public void Destroy()
+        {
+            if (root != null) UnityEngine.Object.Destroy(root);
+        }
+    }
+}
