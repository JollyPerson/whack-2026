diff --git a/Assets/MATE ENGINE - Referee/Editor/DanceModCli.cs b/Assets/MATE ENGINE - Referee/Editor/DanceModCli.cs
new file mode 100644
index 0000000..b8563e9
--- /dev/null
+++ b/Assets/MATE ENGINE - Referee/Editor/DanceModCli.cs	
@@ -0,0 +1,88 @@
+// Headless dance-mod (.me) export. Produces exactly what MateEngine > ME Mod Exporter > Dance Mod produces,
+// because it calls the same ModExporterWindow.ExportDance. Close any editor that has the project open, then:
+//   Unity -batchmode -quit -projectPath <fork> -logFile export.log -executeMethod DanceModCli.Export \
+//     --dance-clip "Assets/<...>.anim" [--dance-audio "Assets/<...>.wav"] --dance-name <name> [--dance-out <dir>] \
+//     [--dance-author <name>] [--dance-mmd-author <name>] [--dance-target StandaloneLinux64]
+// --dance-out defaults to ExportedMods (relative to the project). Without --dance-audio the dance is silent and
+// its length is the clip length. Exit code 1 on any failure.
+using System;
+using System.IO;
+using System.Linq;
+using UnityEditor;
+using UnityEngine;
+
+public static class DanceModCli
+{
+    public static void Export()
+    {
+        try
+        {
+            string clipPath = Arg("--dance-clip");
+            string audioPath = Arg("--dance-audio");
+            string name = Arg("--dance-name");
+            string outDir = Arg("--dance-out") ?? "ExportedMods";
+            string targetName = Arg("--dance-target");
+
+            BuildTarget target = ModExporterWindow.DefaultModBuildTarget();
+            if (targetName != null && !Enum.TryParse(targetName, true, out target)) { Fail("unknown --dance-target '" + targetName + "'"); return; }
+
+            AnimationClip clip = LoadClip(clipPath);
+            if (clip == null) { Fail("--dance-clip: no AnimationClip at '" + clipPath + "'"); return; }
+
+            AudioClip audio = null;
+            if (audioPath != null)
+            {
+                audio = AssetDatabase.LoadAssetAtPath<AudioClip>(audioPath);
+                if (audio == null) { Fail("--dance-audio: no AudioClip at '" + audioPath + "'"); return; }
+            }
+
+            if (string.IsNullOrEmpty(name)) name = clip.name;
+            if (name.IndexOfAny(Path.GetInvalidFileNameChars()) >= 0) { Fail("--dance-name '" + name + "' is not a valid file name"); return; }
+
+            // Same fields MEDanceModCreator.GetMetadata() fills in for the GUI exporter.
+            var meta = new MEDanceModCreator.DanceMeta
+            {
+                songName = audio != null ? audio.name : name,
+                songAuthor = Arg("--dance-author") ?? "",
+                mmdAuthor = Arg("--dance-mmd-author") ?? "",
+                songLength = audio != null ? audio.length : 0f,
+                placeholderClipName = "CUSTOM_DANCE"
+            };
+
+            string mePath = ModExporterWindow.ExportDance(clip, audio, meta, name, target, outDir);
+            if (mePath == null) { Fail("export failed (see errors above)"); return; }
+            Debug.Log("[DanceModCli] exported " + Path.GetFullPath(mePath) + " target=" + target +
+                      " clip=" + clip.name + " (" + clip.length.ToString("0.00") + "s)" +
+                      " audio=" + (audio != null ? audio.name + " (" + audio.length.ToString("0.00") + "s)" : "none"));
+        }
+        catch (Exception e) { Fail(e.ToString()); }
+    }
+
+    // A .anim asset, or the first real clip inside a model file (FBX).
+    static AnimationClip LoadClip(string path)
+    {
+        if (string.IsNullOrEmpty(path)) return null;
+        var clip = AssetDatabase.LoadAssetAtPath<AnimationClip>(path);
+        if (clip != null) return clip;
+        return AssetDatabase.LoadAllAssetsAtPath(path).OfType<AnimationClip>()
+            .FirstOrDefault(c => !c.name.StartsWith("__preview__", StringComparison.Ordinal));
+    }
+
+    static string Arg(string key)
+    {
+        var a = Environment.GetCommandLineArgs();
+        for (int i = 0; i < a.Length - 1; i++)
+            if (string.Equals(a[i], key, StringComparison.OrdinalIgnoreCase))
+            {
+                string v = a[i + 1].Trim('"');
+                return v.Length > 0 ? v : null;
+            }
+        return null;
+    }
+
+    static void Fail(string message)
+    {
+        Debug.LogError("[DanceModCli] " + message);
+        if (Application.isBatchMode) EditorApplication.Exit(1);
+    }
+}
