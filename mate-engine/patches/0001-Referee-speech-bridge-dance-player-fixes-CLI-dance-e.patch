diff --git a/Assets/MATE ENGINE - Referee/Editor/RefereeBuild.cs b/Assets/MATE ENGINE - Referee/Editor/RefereeBuild.cs
new file mode 100644
index 0000000..27329fa
--- /dev/null
+++ b/Assets/MATE ENGINE - Referee/Editor/RefereeBuild.cs	
@@ -0,0 +1,104 @@
+// Command-line Linux player build for the referee fork (used by build-referee.sh at the repository root):
+//   Unity -batchmode -quit -buildTarget Linux64 -projectPath <fork> -logFile <log> \
+//     -executeMethod RefereeBuild.Build --output <dir>/MateEngineX.x86_64 [--scripts-only] [--dev]
+// Unlike CliBuilder it builds the Addressables content (the localisation tables) explicitly first and fails on an
+// Addressables error (the player build would only log it and ship blank localised text), uses LZ4
+// instead of LZ4HC (faster builds), can do a scripts-only rebuild into an existing build folder, and prints
+// every error before exiting with code 1 on failure.
+using System;
+using System.IO;
+using System.Linq;
+using UnityEditor;
+using UnityEditor.AddressableAssets;
+using UnityEditor.AddressableAssets.Build;
+using UnityEditor.AddressableAssets.Settings;
+using UnityEditor.Build.Reporting;
+using UnityEngine;
+
+public static class RefereeBuild
+{
+    const string Scene = "Assets/MATE ENGINE - Scenes/Mate Engine Main.unity";
+
+    public static void Build()
+    {
+        try
+        {
+            string output = Arg("--output");
+            bool scriptsOnly = Has("--scripts-only");
+            bool dev = Has("--dev");
+            if (string.IsNullOrEmpty(output)) { Fail("--output <path/to/MateEngineX.x86_64> is required"); return; }
+            output = Path.GetFullPath(output);
+            Log("output=" + output + " scriptsOnly=" + scriptsOnly + " dev=" + dev);
+
+            AddressablesPlayerBuildResult aa = null;
+            if (!scriptsOnly)
+            {
+                var settings = AddressableAssetSettingsDefaultObject.Settings;
+                if (settings == null) { Fail("no Addressables settings found"); return; }
+                AddressableAssetSettings.BuildPlayerContent(out aa);
+                if (aa == null || !string.IsNullOrEmpty(aa.Error)) { Fail("Addressables build failed: " + (aa != null ? aa.Error : "no result")); return; }
+                Log("Addressables content built in " + aa.Duration.ToString("0.0") + " s");
+            }
+
+            var options = BuildOptions.CompressWithLz4;
+            if (scriptsOnly) options |= BuildOptions.BuildScriptsOnly;
+            if (dev) options |= BuildOptions.Development;
+
+            // The player build would otherwise build the Addressables content a second time (the project follows the
+            // editor preference, which defaults to "build with player"); hand it the result from above instead.
+            // With --scripts-only it still builds it once, as usual.
+            var previousOverride = AddressablesPlayerBuildProcessor.BuildAddressablesOverride;
+            if (aa != null) AddressablesPlayerBuildProcessor.BuildAddressablesOverride = _ => aa;
+            BuildReport report;
+            try
+            {
+                report = BuildPipeline.BuildPlayer(new BuildPlayerOptions
+                {
+                    scenes = new[] { Scene },
+                    locationPathName = output,
+                    target = BuildTarget.StandaloneLinux64,
+                    targetGroup = BuildTargetGroup.Standalone,
+                    options = options
+                });
+            }
+            finally { AddressablesPlayerBuildProcessor.BuildAddressablesOverride = previousOverride; }
+
+            BuildSummary summary = report.summary;
+            if (summary.result != BuildResult.Succeeded)
+            {
+                var errors = report.steps.SelectMany(s => s.messages)
+                    .Where(m => m.type == LogType.Error || m.type == LogType.Exception)
+                    .Select(m => m.content).Distinct().ToList();
+                foreach (var e in errors) Console.WriteLine("RefereeBuild: error: " + e);
+                Fail("build " + summary.result + " with " + summary.totalErrors + " error(s)");
+                return;
+            }
+
+            string aaDir = Path.Combine(Path.GetDirectoryName(output), Path.GetFileNameWithoutExtension(output) + "_Data", "StreamingAssets", "aa");
+            if (!Directory.Exists(aaDir)) Console.WriteLine("RefereeBuild: WARNING: " + aaDir + " is missing; localised UI text will be blank");
+            Log("build succeeded: " + (summary.totalSize / 1048576f).ToString("0.0") + " MB in " +
+                summary.totalTime.TotalSeconds.ToString("0") + " s at " + output);
+        }
+        catch (Exception e) { Fail(e.ToString()); }
+    }
+
+    static string Arg(string key)
+    {
+        var a = Environment.GetCommandLineArgs();
+        for (int i = 0; i < a.Length - 1; i++)
+            if (string.Equals(a[i], key, StringComparison.OrdinalIgnoreCase)) return a[i + 1].Trim('"');
+        return null;
+    }
+
+    static bool Has(string key) =>
+        Environment.GetCommandLineArgs().Any(a => string.Equals(a, key, StringComparison.OrdinalIgnoreCase));
+
+    static void Log(string message) => Console.WriteLine("RefereeBuild: " + message);
+
+    static void Fail(string message)
+    {
+        Console.WriteLine("RefereeBuild: FAILED: " + message);
+        Debug.LogError("RefereeBuild: " + message);
+        EditorApplication.Exit(1);
+    }
+}
