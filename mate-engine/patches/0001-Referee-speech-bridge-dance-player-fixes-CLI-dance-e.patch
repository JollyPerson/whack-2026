diff --git a/build-referee.sh b/build-referee.sh
new file mode 100755
index 0000000..fb54d3e
--- /dev/null
+++ b/build-referee.sh
@@ -0,0 +1,74 @@
+#!/usr/bin/env bash
+# Command-line Linux build of this fork (Assets/MATE ENGINE - Referee/Editor/RefereeBuild.cs).
+#   ./build-referee.sh <output-dir> [--scripts-only] [--dev]
+# Produces <output-dir>/Payload/MateEngineX.x86_64 (+ launch.sh) and <output-dir>/install.sh, like the release
+# layout; the Unity log goes to <output-dir>/build.log. --scripts-only recompiles scripts into an existing build.
+# Environment:
+#   UNITY             Unity 6000.2.6f2 editor binary (default: ~/Unity/Hub/Editor/6000.2.6f2/Editor/Unity)
+#   LIBXML2_SHIM_DIR  directory holding a libxml2.so.2, used only when the system has none (Arch now ships .so.16)
+#   PREBUILT_PAYLOAD  a released MateEngineX Payload/ folder to copy libStandaloneFileBrowser.so from when the
+#                     project lacks it (it is gitignored; without it the build works but file dialogs fail)
+#   NICE              niceness for the editor process (default 5)
+set -euo pipefail
+
+if [ $# -lt 1 ] || [[ "$1" == -* ]]; then
+    echo "usage: $0 <output-dir> [--scripts-only] [--dev]" >&2
+    exit 2
+fi
+P="$(cd "$(dirname "$(realpath "${BASH_SOURCE[0]}")")" && pwd)"
+OUT="$(realpath -m "$1")"
+shift
+UNITY="${UNITY:-$HOME/Unity/Hub/Editor/6000.2.6f2/Editor/Unity}"
+LIBXML2_SHIM_DIR="${LIBXML2_SHIM_DIR:-}"
+
+[ -x "$UNITY" ] || { echo "Unity editor not found at '$UNITY' (set UNITY=...)" >&2; exit 2; }
+for pid in $(pgrep -x Unity || true); do
+    if tr '\0' '\n' < "/proc/$pid/cmdline" 2>/dev/null | grep -qxF -- "$P"; then
+        echo "a Unity editor (pid $pid) has '$P' open; wait for it or close it first" >&2
+        exit 2
+    fi
+done
+
+# Unity 6000.2 links against libxml2.so.2, which newer distributions no longer ship
+# (the ldconfig cache can still list a deleted copy, hence the -e test).
+has_libxml2() {
+    local f
+    for f in $(ldconfig -p 2>/dev/null | awk '/libxml2\.so\.2 /{print $NF}') /usr/lib/libxml2.so.2 \
+             /usr/lib64/libxml2.so.2 /usr/lib/x86_64-linux-gnu/libxml2.so.2; do
+        [ -e "$f" ] && return 0
+    done
+    return 1
+}
+if ! has_libxml2; then
+    if [ -e "$LIBXML2_SHIM_DIR/libxml2.so.2" ]; then
+        export LD_LIBRARY_PATH="$LIBXML2_SHIM_DIR${LD_LIBRARY_PATH:+:$LD_LIBRARY_PATH}"
+        echo "using libxml2.so.2 from $LIBXML2_SHIM_DIR"
+    else
+        echo "warning: no libxml2.so.2 found; set LIBXML2_SHIM_DIR if Unity fails to start" >&2
+    fi
+fi
+
+SFB="$P/Assets/MATE ENGINE - Packages/StandaloneFileBrowser/Plugins/Linux/x86_64/libStandaloneFileBrowser.so"
+if [ ! -e "$SFB" ]; then
+    SRC="${PREBUILT_PAYLOAD:-}/MateEngineX_Data/Plugins/libStandaloneFileBrowser.so"
+    if [ -n "${PREBUILT_PAYLOAD:-}" ] && [ -e "$SRC" ]; then
+        mkdir -p "$(dirname "$SFB")"
+        cp "$SRC" "$SFB"
+        echo "copied libStandaloneFileBrowser.so from $PREBUILT_PAYLOAD"
+    else
+        echo "warning: libStandaloneFileBrowser.so missing (set PREBUILT_PAYLOAD=<release>/Payload); file dialogs will not work" >&2
+    fi
+fi
+
+mkdir -p "$OUT/Payload"
+echo "building into $OUT (log: $OUT/build.log)"
+start=$(date +%s)
+set +e
+nice -n "${NICE:-5}" "$UNITY" -batchmode -quit -buildTarget Linux64 -projectPath "$P" \
+    -executeMethod RefereeBuild.Build --output "$OUT/Payload/MateEngineX.x86_64" "$@" \
+    -logFile "$OUT/build.log"
+rc=$?
+set -e
+echo "build exit=$rc after $(( $(date +%s) - start ))s"
+grep -E "RefereeBuild:|error CS[0-9]+" "$OUT/build.log" | tail -n 20 || true
+exit $rc
diff --git a/tools/mock_mate_server.py b/tools/mock_mate_server.py
new file mode 100755
index 0000000..8f1945b
--- /dev/null
+++ b/tools/mock_mate_server.py
@@ -0,0 +1,56 @@
+#!/usr/bin/env python3
+"""Stand-alone mock of the speech-bridge server (protocol v1, see "Assets/MATE ENGINE - Referee/README.md"),
+so the fork can be run and tested without any other software. Python 3 standard library only.
+  python3 tools/mock_mate_server.py [port]        (default 8765)
+  ./launch.sh -speech-bridge http://127.0.0.1:8765
+Every 25 s it plays: say -> talk on -> talk off -> dance (first installed) -> dance_stop."""
+import json, secrets, sys, threading, time
+from http.server import BaseHTTPRequestHandler, ThreadingHTTPServer
+from urllib.parse import parse_qs, urlparse
+
+EPOCH, PERIOD = secrets.token_hex(4), 25.0
+SCRIPT = [(1, "say", {"text": "Referee here: that figure is out of date. The latest report says 12 percent."}),
+          (2, "talk", {"on": True}), (7, "talk", {"on": False}), (12, "dance", {}), (20, "dance_stop", {})]
+events, cond = [], threading.Condition()  # events[i] has seq i + 1
+
+def cmd(op, **kw):
+    return {"op": op, "id": "", "text": "", "audio": "", "title": "", "on": False, "clear": False, **kw}
+
+def script():
+    for n in range(1, 1_000_000):
+        start = time.time()
+        for at, op, kw in SCRIPT:
+            time.sleep(max(0.0, start + at - time.time()))
+            with cond:
+                events.append(cmd(op, id=f"demo-{n}" if op in ("say", "talk") else "", **kw))
+                cond.notify_all()
+        time.sleep(max(0.0, start + PERIOD - time.time()))
+
+class Handler(BaseHTTPRequestHandler):
+    def do_GET(self):
+        url = urlparse(self.path)
+        if url.path != "/face/mate/next":
+            return self.send_error(404)
+        q = {k: v[0] for k, v in parse_qs(url.query).items()}
+        try:
+            after, wait = int(q.get("after", "-1")), max(0, min(int(q.get("wait", "10")), 25))
+        except ValueError:
+            return self.send_error(400)
+        with cond:
+            if after >= 0 and q.get("epoch") == EPOCH and after <= len(events):
+                cond.wait_for(lambda: len(events) > after, timeout=wait)
+                cmds = events[after:]
+            else:
+                cmds = []  # first poll, other epoch or cursor from the future: resync, never replay
+            body = json.dumps({"v": 1, "epoch": EPOCH, "cursor": len(events), "cmds": cmds}).encode()
+        self.send_response(200)
+        self.send_header("Content-Type", "application/json")
+        self.send_header("Content-Length", str(len(body)))
+        self.end_headers()
+        self.wfile.write(body)
+
+if __name__ == "__main__":
+    port = int(sys.argv[1]) if len(sys.argv) > 1 else 8765
+    threading.Thread(target=script, daemon=True).start()
+    print(f"mock speech-bridge server on http://127.0.0.1:{port}/face/mate/next (epoch {EPOCH})")
+    ThreadingHTTPServer(("127.0.0.1", port), Handler).serve_forever()
