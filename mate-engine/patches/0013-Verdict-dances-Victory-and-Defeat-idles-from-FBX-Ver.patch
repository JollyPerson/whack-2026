@@ -0,0 +1,151 @@
+// Turns humanoid animation FBX files (e.g. Mixamo "Victory" / "Defeated" idles) into dance bundles the custom dance
+// player loads from StreamingAssets/CustomDances, one <name>.unity3d per FBX:
+//   Unity -batchmode -quit -projectPath <project> -executeMethod VerdictDanceCli.Build \
+//     --fbx /path/Victory.fbx --name Victory [--fbx /path/Defeat.fbx --name Defeat ...] --out <dir> \
+//     [--silence 60] [--target StandaloneLinux64]
+// Each FBX is imported as Humanoid (avatar from its own skeleton), its clip made a looping, in-place clip (root motion
+// baked into the pose) and saved as a standalone .anim, so the bundle holds no mesh. A silent audio track of --silence
+// seconds (default 60) goes in the same bundle: without audio the player would restart a short idle every few seconds
+// (it auto-advances at the clip's end), with it the idle loops smoothly until the bridge's timer stops it.
+// The FBX files are copied into a temporary folder under Assets and deleted afterwards. Exits 1 on any failure.
+using System;
+using System.Collections.Generic;
+using System.IO;
+using System.Linq;
+using UnityEditor;
+using UnityEngine;
+
+public static class VerdictDanceCli
+{
+    const string TempDir = "Assets/_VerdictDanceBuild";
+
+    public static void Build()
+    {
+        bool ok = false;
+        try { ok = Run(); }
+        catch (Exception e) { Debug.LogError("VerdictDanceCli: " + e); }
+        finally
+        {
+            if (AssetDatabase.IsValidFolder(TempDir)) AssetDatabase.DeleteAsset(TempDir);
+            AssetDatabase.Refresh();
+        }
+        Debug.Log("VerdictDanceCli: " + (ok ? "done" : "FAILED"));
+        EditorApplication.Exit(ok ? 0 : 1);
+    }
+
+    static bool Run()
+    {
+        string[] args = Environment.GetCommandLineArgs();
+        var fbx = Values(args, "--fbx");
+        var names = Values(args, "--name");
+        string outDir = Value(args, "--out");
+        float silence = float.TryParse(Value(args, "--silence") ?? "60", System.Globalization.NumberStyles.Float,
+                                       System.Globalization.CultureInfo.InvariantCulture, out var s) ? s : 60f;
+        BuildTarget target = BuildTarget.StandaloneLinux64;
+        string targetName = Value(args, "--target");
+        if (targetName != null && !Enum.TryParse(targetName, true, out target)) return Fail("unknown --target '" + targetName + "'");
+        if (fbx.Count == 0 || fbx.Count != names.Count) return Fail("give one --name per --fbx");
+        if (string.IsNullOrEmpty(outDir)) return Fail("--out is required");
+        if (silence < 1f || silence > 600f) return Fail("--silence must be 1-600 seconds");
+
+        if (!AssetDatabase.IsValidFolder(TempDir)) AssetDatabase.CreateFolder("Assets", "_VerdictDanceBuild");
+        var builds = new List<AssetBundleBuild>();
+        for (int i = 0; i < fbx.Count; i++)
+        {
+            string name = names[i];
+            if (name.Length == 0 || name.IndexOfAny(Path.GetInvalidFileNameChars()) >= 0) return Fail("bad --name '" + name + "'");
+            if (!File.Exists(fbx[i])) return Fail("no file " + fbx[i]);
+
+            string model = TempDir + "/" + name + ".fbx";
+            File.Copy(fbx[i], model, true);
+            AssetDatabase.ImportAsset(model, ImportAssetOptions.ForceSynchronousImport);
+            var importer = (ModelImporter)AssetImporter.GetAtPath(model);
+            importer.animationType = ModelImporterAnimationType.Human;
+            importer.avatarSetup = ModelImporterAvatarSetup.CreateFromThisModel;
+            importer.importAnimation = true;
+            var clipSettings = importer.defaultClipAnimations;
+            if (clipSettings.Length == 0) return Fail(fbx[i] + " has no animation take");
+            foreach (var c in clipSettings)
+            {
+                c.loopTime = true;
+                c.lockRootRotation = true; c.keepOriginalOrientation = true;
+                c.lockRootHeightY = true; c.keepOriginalPositionY = true;
+                c.lockRootPositionXZ = true; c.keepOriginalPositionXZ = true;
+            }
+            importer.clipAnimations = clipSettings;
+            importer.SaveAndReimport();
+
+            var assets = AssetDatabase.LoadAllAssetsAtPath(model);
+            var avatar = assets.OfType<Avatar>().FirstOrDefault();
+            if (avatar == null || !avatar.isValid || !avatar.isHuman) return Fail(fbx[i] + ": no valid humanoid avatar (is it a humanoid rig?)");
+            var clip = assets.OfType<AnimationClip>().FirstOrDefault(a => !a.name.StartsWith("__preview__", StringComparison.Ordinal));
+            if (clip == null || !clip.humanMotion) return Fail(fbx[i] + ": no humanoid animation clip");
+
+            var copy = UnityEngine.Object.Instantiate(clip);
+            copy.name = name;
+            var settings = AnimationUtility.GetAnimationClipSettings(copy);
+            settings.loopTime = true;
+            AnimationUtility.SetAnimationClipSettings(copy, settings);
+            string anim = TempDir + "/" + name + ".anim";
+            AssetDatabase.CreateAsset(copy, anim);
+
+            string wav = TempDir + "/" + name + "_silence.wav";
+            WriteSilentWav(wav, silence);
+            AssetDatabase.ImportAsset(wav, ImportAssetOptions.ForceSynchronousImport);
+
+            builds.Add(new AssetBundleBuild { assetBundleName = name.ToLowerInvariant() + ".unity3d", assetNames = new[] { anim, wav } });
+            Debug.Log("VerdictDanceCli: " + name + " <- " + Path.GetFileName(fbx[i]) + " (" + copy.length.ToString("0.00") + " s, loops, " +
+                      silence.ToString("0") + " s silent track)");
+        }
+        AssetDatabase.SaveAssets();
+
+        string buildDir = Path.Combine(Path.GetTempPath(), "VerdictDanceCli-" + Guid.NewGuid().ToString("N"));
+        Directory.CreateDirectory(buildDir);
+        try
+        {
+            var manifest = BuildPipeline.BuildAssetBundles(buildDir, builds.ToArray(), BuildAssetBundleOptions.ChunkBasedCompression, target);
+            if (manifest == null) return Fail("BuildAssetBundles failed (is " + target + " build support installed?)");
+            Directory.CreateDirectory(outDir);
+            for (int i = 0; i < names.Count; i++)
+            {
+                string built = Path.Combine(buildDir, builds[i].assetBundleName);
+                string dest = Path.Combine(outDir, names[i] + ".unity3d");   // the player's dance title is the file name
+                File.Copy(built, dest, true);
+                Debug.Log("VerdictDanceCli: wrote " + dest + " (" + new FileInfo(dest).Length / 1024 + " KB)");
+            }
+        }
+        finally { try { Directory.Delete(buildDir, true); } catch { } }
+        return true;
+    }
+
+    static void WriteSilentWav(string path, float seconds)
+    {
+        const int rate = 22050;
+        int samples = (int)(rate * seconds);
+        using var w = new BinaryWriter(File.Create(path));
+        w.Write(new[] { 'R', 'I', 'F', 'F' }); w.Write(36 + samples * 2); w.Write(new[] { 'W', 'A', 'V', 'E' });
+        w.Write(new[] { 'f', 'm', 't', ' ' }); w.Write(16); w.Write((short)1); w.Write((short)1);
+        w.Write(rate); w.Write(rate * 2); w.Write((short)2); w.Write((short)16);
+        w.Write(new[] { 'd', 'a', 't', 'a' }); w.Write(samples * 2);
+        w.Write(new byte[samples * 2]);
+    }
+
+    static string Value(string[] args, string flag)
+    {
+        int i = Array.IndexOf(args, flag);
+        return i >= 0 && i + 1 < args.Length ? args[i + 1] : null;
+    }
+
+    static List<string> Values(string[] args, string flag)
+    {
+        var list = new List<string>();
+        for (int i = 0; i + 1 < args.Length; i++) if (args[i] == flag) list.Add(args[i + 1]);
+        return list;
+    }
+
+    static bool Fail(string msg)
+    {
+        Debug.LogError("VerdictDanceCli: " + msg);
+        return false;
+    }
+}
