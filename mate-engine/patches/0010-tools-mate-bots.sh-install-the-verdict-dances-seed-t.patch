     local v
@@ -302,7 +356,11 @@ esac
 case "$cmd" in
     start)
         [ -x "$PAYLOAD/$EXE" ] || { echo "no build at $PAYLOAD/$EXE (set PAYLOAD=<build>/Payload)" >&2; exit 2; }
+        install_dances
         for p in "${personas[@]}"; do start_one "$p"; done ;;
+    dances)
+        [ -x "$PAYLOAD/$EXE" ] || { echo "no build at $PAYLOAD/$EXE (set PAYLOAD=<build>/Payload)" >&2; exit 2; }
+        install_dances ;;
     stop) stop_all "${personas[@]}" ;;
     status) for p in "${personas[@]}"; do status_one "$p"; done ;;
     place) place "${personas[@]}" ;;
