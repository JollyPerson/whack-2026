+# Copies the DANCES titles from DANCE_LIBRARY (searched recursively; a title is a file name without its .unity3d or .me
+# extension, matched in any case, like the player's FindIndexByTitle) into the build. A file already there with the
+# same bytes is left alone. A missing title is reported, not fatal: the bridge then plays the first installed dance.
+install_dances() {
+    python3 -I - "$DANCE_LIBRARY" "$PAYLOAD/MateEngineX_Data/StreamingAssets/CustomDances" "$DANCES" <<'PY'
+import filecmp, os, shutil, sys
+lib, dest, titles = sys.argv[1], sys.argv[2], [t.strip() for t in sys.argv[3].split(";") if t.strip()]
+found = {}
+for root, dirs, files in os.walk(lib):
+    dirs.sort()
+    for f in sorted(files):
+        stem, ext = os.path.splitext(f)
+        if ext.lower() in (".unity3d", ".me"):
+            found.setdefault(stem.casefold(), os.path.join(root, f))
+if not found:
+    print(f"dances: no .unity3d or .me files in {lib}; the verdict dances are not installed", file=sys.stderr)
+    sys.exit(0)
+os.makedirs(dest, exist_ok=True)
+done, missing = [], []
+for title in titles:
+    src = found.get(title.casefold())
+    if src is None:
+        missing.append(title)
+        continue
+    dst = os.path.join(dest, os.path.basename(src))
+    if os.path.isfile(dst) and filecmp.cmp(src, dst, shallow=False):
+        done.append(f"'{title}' present")
+        continue
+    tmp = dst + ".tmp"
+    shutil.copyfile(src, tmp)
+    os.replace(tmp, dst)
+    done.append(f"'{title}' installed")
+if done:
+    print(f"dances: {', '.join(done)} in {dest}")
+if missing:
+    print(f"dances: not found in {lib}: {', '.join(repr(t) for t in missing)}", file=sys.stderr)
+PY
+}
+
 # The 32-bit ARGB visual a transparent window needs, found the way the build's launch.sh does.
