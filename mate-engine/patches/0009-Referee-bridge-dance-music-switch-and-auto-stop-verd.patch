+        IEnumerator StopDanceAfter(float seconds)
+        {
+            yield return new WaitForSecondsRealtime(seconds);
+            danceTimer = null;
+            if (dance != null && dance.IsPlaying)
+            {
+                dance.StopPlay();
+                Debug.Log("[SpeechBridge] dance stopped after " + seconds.ToString("0.#") + " s");
+            }
+            else Debug.Log("[SpeechBridge] dance already over at its " + seconds.ToString("0.#") + " s stop");
+        }
+
+        void CancelDanceTimer()
+        {
+            if (danceTimer == null) return;
+            StopCoroutine(danceTimer);
+            danceTimer = null;
+        }
+
+        // Sets the dance player's volume (and loop) for a held dance, saving the player's own first.
+        void HoldDance(float volume, bool loop)
+        {
+            if (danceHeld && heldOn != dance) ReleaseDance();
+            var src = dance.audioSource;
+            if (!danceHeld)
+            {
+                heldOn = dance;
+                playerVolume = src != null ? src.volume : -1f;
+                playerLoop = dance.loopOn;
+                danceHeld = true;
+            }
+            danceHeldAt = Now;
+            danceSeenPlaying = false;
+            danceLogged = false;
+            if (src != null) src.volume = volume;
+            else LogOnce("noaudiosource", "[SpeechBridge] the dance player has no AudioSource; cannot set the music volume");
+            // A timed dance repeats its own title rather than going on to the next installed one.
+            dance.loopOn = loop || playerLoop;
+        }
+
+        void ReleaseDance()
+        {
+            if (!danceHeld) return;
+            danceHeld = false;
+            if (heldOn == null) return;
+            if (heldOn.audioSource != null && playerVolume >= 0f) heldOn.audioSource.volume = playerVolume;
+            heldOn.loopOn = playerLoop;
+            Debug.Log("[SpeechBridge] dance over; dance volume back to " + playerVolume.ToString("0.00"));
+        }
+
+        // Per frame while a dance is held: log once what actually plays, and release it once it is over, however it
+        // ended (timer, dance_stop, a line with stopDanceOnSay, the menu, or a title that never started).
+        void WatchDance(float now)
+        {
+            if (heldOn == null) { danceHeld = false; return; }
+            if (!heldOn.IsPlaying)
+            {
+                if (danceSeenPlaying || now - danceHeldAt > DanceStartTimeout) ReleaseDance();
+                return;
+            }
+            danceSeenPlaying = true;
+            var src = heldOn.audioSource;
+            if (danceLogged || (src != null && src.clip != null && !src.isPlaying)) return; // still in the transition
+            danceLogged = true;
+            var clip = heldOn.GetCurrentClip();
+            Debug.Log("[SpeechBridge] dancing: clip=" + (clip != null ? clip.name : "none") +
+                      " audio=" + (src != null && src.clip != null ? src.clip.name : "none") +
+                      " playing=" + (src != null && src.isPlaying) +
+                      " volume=" + (src != null ? src.volume.ToString("0.00") : "?") + " loop=" + heldOn.loopOn);
+        }
