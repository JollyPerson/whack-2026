@@ -1,9 +1,15 @@
 #!/usr/bin/env python3
 """Stand-alone mock of the speech-bridge server (protocol v1, see "Assets/MATE ENGINE - Referee/README.md"),
 so the fork can be run and tested without any other software. Python 3 standard library only.
-  python3 tools/mock_mate_server.py [port]        (default 8765)
+  python3 tools/mock_mate_server.py [port] [--bots]        (default 8765)
   ./launch.sh -speech-bridge http://127.0.0.1:8765
-Every 25 s it plays: say -> talk on -> talk off -> dance (first installed) -> dance_stop."""
+Every 25 s it plays: say -> talk on -> talk off -> dance (first installed) -> dance_stop.
+Channels, like the debate server: /face/mate/next/referee (= /face/mate/next, the loop above), /face/mate/next/for and
+/face/mate/next/against (the side bots: text only, so a line is say + talk on, then talk off after its hold time).
+A poll gets only its own channel's commands. Pick an instance's channel with "pollPath" in its speech_bridge.json.
+  --bots                                   every 12 s, one side-bot line, alternating for / against
+  POST /say?channel=for&text=...[&hold=8]  say + talk on now, talk off after hold s (default: words / 2.5 + 3, 6-12)
+  POST /stop?channel=for[&clear=1]         stop; channel=all reaches every channel"""
 import json, secrets, sys, threading, time
 from http.server import BaseHTTPRequestHandler, ThreadingHTTPServer
 from urllib.parse import parse_qs, urlparse
@@ -11,38 +17,81 @@ from urllib.parse import parse_qs, urlparse
 EPOCH, PERIOD = secrets.token_hex(4), 25.0
 SCRIPT = [(1, "say", {"text": "Referee here: that figure is out of date. The latest report says 12 percent."}),
           (2, "talk", {"on": True}), (7, "talk", {"on": False}), (12, "dance", {}), (20, "dance_stop", {})]
-events, cond = [], threading.Condition()  # events[i] has seq i + 1
+BOT_LINES = [("for", "ONS says 4.2%, not 6%. Try again."), ("against", "Source for that 40%?"),
+             ("for", "You still haven't answered our point on rents."), ("against", "Bold claim. Evidence, please.")]
+CHANNELS = ("referee", "for", "against")
+events, cond = [], threading.Condition()  # events[i] = (channel or "all", cmd) has seq i + 1
+ids = iter(range(1, 1_000_000))
 
 def cmd(op, **kw):
     return {"op": op, "id": "", "text": "", "audio": "", "title": "", "on": False, "clear": False, **kw}
 
+def emit(channel, op, **kw):
+    with cond:
+        events.append((channel, cmd(op, **kw)))
+        cond.notify_all()
+
 def script():
     for n in range(1, 1_000_000):
         start = time.time()
         for at, op, kw in SCRIPT:
             time.sleep(max(0.0, start + at - time.time()))
-            with cond:
-                events.append(cmd(op, id=f"demo-{n}" if op in ("say", "talk") else "", **kw))
-                cond.notify_all()
+            emit("referee", op, id=f"demo-{n}" if op in ("say", "talk") else "", **kw)
         time.sleep(max(0.0, start + PERIOD - time.time()))
 
+def bot_say(channel, text, hold=None):
+    """A side-bot line as the server sends it: BotLine -> say + talk on, BotTalk(on=false) after hold_s -> talk off."""
+    line_id = f"b-{next(ids):04d}"
+    hold = hold if hold is not None else min(max(len(text.split()) / 2.5 + 3, 6.0), 12.0)
+    emit(channel, "say", id=line_id, text=text)
+    emit(channel, "talk", id=line_id, on=True)
+    threading.Timer(hold, emit, (channel, "talk"), {"id": line_id, "on": False}).start()
+    print(f"{time.strftime('%H:%M:%S')} {channel}: say {line_id} hold {hold:.1f}s {text!r}", flush=True)
+    return line_id
+
+def bots():
+    for n in range(1_000_000):
+        time.sleep(12.0)
+        bot_say(*BOT_LINES[n % len(BOT_LINES)])
+
 class Handler(BaseHTTPRequestHandler):
     def do_GET(self):
         url = urlparse(self.path)
-        if url.path != "/face/mate/next":
+        channel = "referee" if url.path == "/face/mate/next" else url.path.removeprefix("/face/mate/next/")
+        if channel not in CHANNELS:
             return self.send_error(404)
         q = {k: v[0] for k, v in parse_qs(url.query).items()}
         try:
             after, wait = int(q.get("after", "-1")), max(0, min(int(q.get("wait", "10")), 25))
         except ValueError:
             return self.send_error(400)
+        mine = lambda: [c for ch, c in events[after:] if ch in (channel, "all")]
         with cond:
             if after >= 0 and q.get("epoch") == EPOCH and after <= len(events):
-                cond.wait_for(lambda: len(events) > after, timeout=wait)
-                cmds = events[after:]
+                cond.wait_for(mine, timeout=wait)
+                cmds = mine()
             else:
                 cmds = []  # first poll, other epoch or cursor from the future: resync, never replay
-            body = json.dumps({"v": 1, "epoch": EPOCH, "cursor": len(events), "cmds": cmds}).encode()
+            cursor = len(events)
+        self.reply({"v": 1, "epoch": EPOCH, "cursor": cursor, "cmds": cmds})
+
+    def do_POST(self):
+        url = urlparse(self.path)
+        q = {k: v[0] for k, v in parse_qs(url.query).items()}
+        channel = q.get("channel", "")
+        if url.path == "/say" and channel in CHANNELS and q.get("text"):
+            try:
+                hold = float(q["hold"]) if "hold" in q else None
+            except ValueError:
+                return self.send_error(400)
+            return self.reply({"ok": True, "id": bot_say(channel, q["text"], hold)})
+        if url.path == "/stop" and (channel in CHANNELS or channel == "all"):
+            emit(channel, "stop", clear=q.get("clear", "0") not in ("", "0", "false"))
+            return self.reply({"ok": True})
+        self.send_error(404)
+
+    def reply(self, obj):
+        body = json.dumps(obj).encode()
         self.send_response(200)
         self.send_header("Content-Type", "application/json")
         self.send_header("Content-Length", str(len(body)))
@@ -50,7 +99,10 @@ class Handler(BaseHTTPRequestHandler):
         self.wfile.write(body)
 
 if __name__ == "__main__":
-    port = int(sys.argv[1]) if len(sys.argv) > 1 else 8765
+    args = [a for a in sys.argv[1:] if a != "--bots"]
+    port = int(args[0]) if args else 8765
     threading.Thread(target=script, daemon=True).start()
-    print(f"mock speech-bridge server on http://127.0.0.1:{port}/face/mate/next (epoch {EPOCH})")
+    if "--bots" in sys.argv[1:]:
+        threading.Thread(target=bots, daemon=True).start()
+    print(f"mock speech-bridge server on http://127.0.0.1:{port}/face/mate/next[/referee|/for|/against] (epoch {EPOCH})")
     ThreadingHTTPServer(("127.0.0.1", port), Handler).serve_forever()
