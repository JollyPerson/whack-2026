+                          "), outer corner (" + Mathf.RoundToInt(corner.x) + "," + Mathf.RoundToInt(corner.y) + ") in a " +
+                          Screen.width + "x" + Screen.height + " window";
+            else if (cfg.bubbleSide.Length > 0) layout += ", ME's own spot: no head bone or canvas to place it " + cfg.bubbleSide;
+            var bubble = new SpeechBubble(textGo, text, layout);
