+        }
+
+        // bubbleSide: called every frame after the animation, keeps the bubble beside the head. ME's idle animations
+        // move the avatar by up to about a head's width; the bubble follows sideways only (its top stays, so the text
+        // does not bob) and stops at the window edge.
+        public void Follow(float dt)
+        {
+            if (avatar == null || root == null) return; // not placed beside a head, gone, or the avatar was replaced
+            if (!Measure(container, out var uiCam, out var origin, out var px) ||
+                !BesideHead(avatar, uiCam, cfg, out _, out var corner)) return;
+            bool right = cfg.bubbleSide == "right";
+            edgeX = Mathf.Lerp(edgeX, ClampEdge(corner.x, width * px, right), 1f - Mathf.Exp(-FollowRate * dt));
+            rect.anchoredPosition = new Vector2((edgeX - origin.x) / px + (right ? pad : -pad), rect.anchoredPosition.y);
+        }
+
+        // Keeps a bubble of the given outer width (pixels) whose near edge is at x inside the window.
+        static float ClampEdge(float x, float widthPx, bool right) => right
+            ? Mathf.Max(EdgeMarginPx, Mathf.Min(x, Screen.width - EdgeMarginPx - widthPx))
+            : Mathf.Min(Screen.width - EdgeMarginPx, Mathf.Max(x, EdgeMarginPx + widthPx));
+
+        // Screen point of the container's pivot and screen pixels per container unit, measured through its transform
+        // so that the canvas scaler and every scale in between count. False while the canvas has no size yet.
+        static bool Measure(Transform container, out Camera uiCam, out Vector2 origin, out float px)
+        {
+            var canvas = container.GetComponentInParent<Canvas>();
+            if (canvas != null) canvas = canvas.rootCanvas;
+            uiCam = canvas != null && canvas.renderMode != RenderMode.ScreenSpaceOverlay ? canvas.worldCamera : null;
+            origin = RectTransformUtility.WorldToScreenPoint(uiCam, container.position);
+            px = (RectTransformUtility.WorldToScreenPoint(uiCam, container.TransformPoint(100f, 0f, 0f)) - origin).x / 100f;
+            return px > 1e-4f;
+        }
+
+        // Screen points (pixels from the bottom left) of the avatar's head bone and of the bubble's outer corner
+        // beside it: bubbleGap to the chosen side and bubbleTop above, in metres scaled with the avatar, so they keep
+        // their place next to the head whatever the window or avatar size. False for an avatar without a head bone.
+        static bool BesideHead(Animator avatar, Camera uiCam, SpeechBridgeConfig cfg, out Vector2 head, out Vector2 corner)
+        {
+            head = corner = Vector2.zero;
+            Transform bone = avatar != null && avatar.isHuman ? avatar.GetBoneTransform(HumanBodyBones.Head) : null;
+            Camera eye = uiCam != null ? uiCam : Camera.main; // ME draws the avatar and its UI with the same camera
+            if (bone == null || eye == null) return false;
+            Vector3 p = bone.position, sideways = eye.transform.right * (cfg.bubbleSide == "right" ? 1f : -1f);
+            float scale = avatar.transform.lossyScale.y;
+            head = eye.WorldToScreenPoint(p);
+            corner = new Vector2(eye.WorldToScreenPoint(p + sideways * (cfg.bubbleGap * scale)).x,
+                                 eye.WorldToScreenPoint(p + eye.transform.up * (cfg.bubbleTop * scale)).y);
+            return true;
         }
 
         public void SetText(string text)
